{
  "compileOnSave": false,
  "compilerOptions": {
    "experimentalDecorators": true,
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2022",
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "lib": ["es2019", "esnext", "dom"],
    "paths": {
      "@kadaster/ggc-conversion": ["dist/ggc-conversion"],
      "@kadaster/ggc-map-3d": ["dist/ggc-map-3d"],
      "@kadaster/ggc-dataset-tree": ["dist/ggc-dataset-tree"],
      "@kadaster/ggc-feature-info": ["dist/ggc-feature-info"],
      "@kadaster/ggc-legend": ["dist/ggc-legend"],
      "@kadaster/ggc-map": ["dist/ggc-map"],
      "@kadaster/ggc-models": ["dist/ggc-models"],
      "@kadaster/ggc-search-location": ["dist/ggc-search-location"],
      "@kadaster/ggc-toolbar": ["dist/ggc-toolbar"]
    },
    "useDefineForClassFields": false
  },
  "files": ["src/test/setup-tests.ts"],
  "references": [
    {
      "path": "./projects/ggc-conversion/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-map-3d/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-dataset-tree/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-feature-info/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-home/tsconfig.app.json"
    },
    {
      "path": "./projects/ggc-home/tsconfig.spec.json"
    },
    {
      "path": "./projects/ggc-legend/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-map/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-models/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-search-location/tsconfig.lib.json"
    },
    {
      "path": "./projects/ggc-toolbar/tsconfig.lib.json"
    }
  ]
}
