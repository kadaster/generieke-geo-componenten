<app-example-format
  [title]="componentInfo.title"
  [pathModule]="urlComponentModule"
  [urlTSDocs]="tsDocsUrl"
  {{#if kaartConfig}}
  pathKaartConfig="{{categoryFolder}}/{{exampleFolder}}/kaartconfig.json"
  {{/if}}
>
  @if (componentInfo.tags && componentInfo.tags?.length > 0) {
    <div page-labels>
      @for (tag of componentInfo.tags; track tag) {
        <span class="badge rounded-pill tag-technical mx-1">\{{
          tag.toLocaleLowerCase()
        }}</span>
      }
    </div>
  }

  <div page-introduction>
    <p>\{{ componentInfo.introduction }}</p>
    <!-- TODO: vul hier eventuele extra introductietekst/instructies in -->
  </div>

  <div page-functionality>
    <div class="row">
      <!-- DOCS:START functionality -->
      {{#if (eq layout "draw-style")}}
      <div class="col-xl-2 col-md-3 col-sm-12">
        <fieldset class="ggc-fieldset">
          <legend>TODO: bediening</legend>
          <!-- TODO: vul hier de specifieke bediening van dit voorbeeld in -->
        </fieldset>
      </div>
      <div class="col-xl-8 col-md-7 col-sm-12">
        <div class="map-container">
          <ggc-map {{#if mapIndex}}[mapIndex]="mapIndex" {{/if}}[webServices]="mapConfig"></ggc-map>
        </div>
      </div>
      {{/if}}
      {{#if (eq layout "info-style")}}
      <div class="col-xl-3 col-md-5 col-sm-5">
        <!-- TODO: vul hier het infopaneel van dit voorbeeld in -->
      </div>
      <div class="col-xl-6 col-md-4 col-sm-4">
        <div class="map-container">
          <ggc-map {{#if mapIndex}}[mapIndex]="mapIndex" {{/if}}[webServices]="mapConfig"></ggc-map>
        </div>
      </div>
      {{/if}}
      <!-- DOCS:END functionality -->

      {{#if advancedButton}}
      <div class="col-xl-2 col-md-2 col-sm-12">
        <div class="row options-toggle">
          <h6 id="extraOptionsLabel">Extra opties</h6>
          <label class="switch">
            <input
              (change)="goToPage('{{toggleRoute}}')"
              aria-labelledby="extraOptionsLabel"
              type="checkbox"
              {{~#if isAdvancedVariant}} checked{{/if}}
            />
            <span class="slider round"></span>
          </label>
        </div>
      </div>
      {{/if}}
    </div>
  </div>
</app-example-format>
