{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ggc-cesium": {
      "projectType": "library",
      "root": "projects/ggc-cesium",
      "sourceRoot": "projects/ggc-cesium/src",
      "prefix": "ggc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ggc-cesium/tsconfig.lib.json",
            "project": "projects/ggc-cesium/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ggc-cesium/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ggc-cesium/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "runnerConfig": "vitest.config.ts",
            "setupFiles": ["src/test/setup-tests.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ggc-cesium/**/*.ts",
              "projects/ggc-cesium/**/*.html"
            ]
          }
        }
      }
    },
